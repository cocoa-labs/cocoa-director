# Local, no-cost demo. Real media is synthetic; provider estimates are simulated.
PROVIDER_MODE=mock
# Empty permits mock operations. Live mode requires explicit true.
PROVIDER_CALLS_ENABLED=
REQUIRE_AUTH=false
DAILY_BUDGET_CAP_USD_PER_USER=50
DAILY_BUDGET_CAP_USD_GLOBAL=50
DEV_SPEND_CAP_EXEMPT=false
# Optional absolute paths; otherwise FFmpeg/ffprobe are discovered on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
