# Copy through npm run setup -- --mode=live. Supply your own accounts and keys.
PROVIDER_MODE=live
PROVIDER_CALLS_ENABLED=false
REQUIRE_AUTH=true
AUTH_SECRET=
ADMIN_INVITE_CODES=
INVITE_CODES=
OPENAI_API_KEY=
FAL_KEY=
ELEVENLABS_API_KEY=
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
PRIVATE_BLOB_READ_WRITE_TOKEN=
DAILY_BUDGET_CAP_USD_PER_USER=50
DAILY_BUDGET_CAP_USD_GLOBAL=50
DEV_SPEND_CAP_EXEMPT=false
SPEND_CAP_EXEMPT_EMAILS=
SPEND_CAP_EXEMPT_USER_IDS=
# Keep the existing creative defaults. These are optional overrides.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high
OPENAI_AGENT_MODEL=gpt-5.6-terra
OPENAI_STYLE_MODEL=gpt-5.6-terra
OPENAI_LYRICS_MODEL=gpt-5.6-terra
OPENAI_FACTUAL_AUDIT_MODEL=gpt-5.6-sol
OPENAI_VISION_AUDIT_MODEL=gpt-5.6-sol
OPENAI_OCR_MODEL=gpt-5.6-terra
ELEVENLABS_MUSIC_MODEL_ID=music_v1
ELEVENLABS_MUSIC_OUTPUT_FORMAT=mp3_44100_192
ELEVENLABS_NEWS_VOICE_ID=
ELEVENLABS_TTS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_TTS_USD_PER_1000_CHARACTERS=0.30
SEEDANCE_STANDARD_ENDPOINT=bytedance/seedance-2.0/reference-to-video
SEEDANCE_FAST_ENDPOINT=bytedance/seedance-2.0/fast/reference-to-video
NEWS_DIGEST_V2_ENABLED=true
NEWS_WEB_RESEARCH_ENABLED=false
NEWS_PRESENTER_ENABLED=false
HYBRID_VISUALS_V2_ENABLED=true
CINEMATIC_REENACTMENTS_ENABLED=true
PRODUCTION_PROGRESS_V2_ENABLED=true
HYBRID_WORKFLOW_V4_ENABLED=true
HYBRID_SAFE_RECOVERY_ENABLED=true
IMMUTABLE_GENERATION_OUTPUTS_ENABLED=true
EDITORIAL_DIRECTION_V3_ENABLED=true
VISUAL_VARIETY_QA_ENABLED=true
VISUAL_AUTOPOLISH_ENABLED=true
EDITORIAL_TIMING_V2_ENABLED=true
SOURCE_VISUALS_V2_ENABLED=true
LAYERED_EDITORIAL_COMPOSITOR_ENABLED=true
EDITORIAL_MOTION_QA_ENABLED=true
LIKENESS_VIDEO_ENABLED=true
LIKENESS_LIVE_VALIDATED=false
CRON_SECRET=
ALLOW_DEV_MEMORY_RESET=false
# Local rendering uses system tools. Vercel uses pinned Linux tools and OIDC.
FFMPEG_PATH=
FFPROBE_PATH=
# Optional local use of Sandbox; all three must be supplied together.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
