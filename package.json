{
  "name": "cocoa-director",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "media:setup": "node scripts/media-setup.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.49.1",
    "@fal-ai/client": "^1.10.0",
    "@napi-rs/canvas": "^1.0.3",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "16.3.8",
    "@types/pg": "^8.20.0",
    "@vercel/blob": "^2.3.3",
    "@vercel/sandbox": "^2.9.0",
    "lucide-react": "^1.14.0",
    "next": "16.3.8",
    "openai": "^6.35.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tar-stream": "3.2.1",
    "undici": "^6.28.0",
    "workflow": "^4.7.0",
    "xz-decompress": "0.2.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "fast-uri": "^3.1.4",
    "postcss": "^8.5.24",
    "@workflow/core": {
      "devalue": "5.9.3",
      "nanoid": "5.1.16"
    }
  },
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cocoa-labs/cocoa-director.git"
  }
